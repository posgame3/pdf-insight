{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Public configuration only. The API key is a secret: `npx wrangler secret put ANTHROPIC_API_KEY`.
  "vars": {
    "ALLOWED_ORIGINS": "https://posgame3.github.io",
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "ANTHROPIC_EFFORT": "medium",
  },
  // Per-IP limit on /analyze. Each analysis costs real money, so the limit is deliberately tight.
  "ratelimits": [{ "name": "ANALYZE_RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 5, "period": 60 } }],
}
