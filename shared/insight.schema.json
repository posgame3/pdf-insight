{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$",
          "description": "ISO 639-1 code of the main language of the document, e.g. \"pl\""
        },
        "type": {
          "type": "string",
          "enum": [
            "faktura",
            "umowa",
            "oferta",
            "raport",
            "inne"
          ],
          "description": "Document type; \"inne\" when none of the others fits"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "description": "Title as stated in the document, or null"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date the document was issued or concluded (for a contract: the conclusion date), ISO 8601, or null. Not a payment, delivery or validity date."
        }
      },
      "required": [
        "fileName",
        "pages",
        "language",
        "type",
        "title",
        "date"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500,
      "description": "Exactly 4 full sentences (3–5 accepted, about 600–900 characters) in the document language, without abbreviations, reflecting the terms currently in force"
    },
    "keyPoints": {
      "minItems": 3,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "3–7 most important facts, obligations or risks, one short sentence each"
    },
    "entities": {
      "type": "object",
      "properties": {
        "organizations": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "Organizations acting in the document (parties, subcontractors, authorities with a role), each once, full name"
        },
        "people": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": "People named in the document, each once, in the nominative case (e.g. \"Jan Kowalski\")"
        }
      },
      "required": [
        "organizations",
        "people"
      ],
      "additionalProperties": false
    },
    "amounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "description": "Amount as a number with a dot as decimal separator, e.g. 12500.5 for \"12 500,50 zł\""
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 code; \"zł\" and \"złotych\" are PLN, \"€\" is EUR, \"$\" is USD"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "What the amount is, in the document language: its role, net/gross/VAT and period, e.g. \"abonament miesięczny netto\""
          },
          "source": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "1-based page number on which the value is stated"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "Verbatim fragment of that page, at most ~120 characters, containing the value exactly as written"
              }
            },
            "required": [
              "page",
              "quote"
            ],
            "additionalProperties": false,
            "description": "Where the value comes from, so it can be verified against the document text"
          },
          "verification": {
            "type": "string",
            "enum": [
              "text",
              "scan",
              "unconfirmed"
            ],
            "description": "text = quote and value found in the PDF text layer; scan = read from a scanned page; unconfirmed = not found"
          }
        },
        "required": [
          "value",
          "currency",
          "context",
          "source",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})$",
            "description": "ISO 8601 date (YYYY-MM-DD) explicitly stated in the document"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "What happens on that date, in the document language, e.g. \"termin płatności zaliczki\""
          },
          "source": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "1-based page number on which the value is stated"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "Verbatim fragment of that page, at most ~120 characters, containing the value exactly as written"
              }
            },
            "required": [
              "page",
              "quote"
            ],
            "additionalProperties": false,
            "description": "Where the value comes from, so it can be verified against the document text"
          },
          "verification": {
            "type": "string",
            "enum": [
              "text",
              "scan",
              "unconfirmed"
            ],
            "description": "text = quote and value found in the PDF text layer; scan = read from a scanned page; unconfirmed = not found"
          }
        },
        "required": [
          "date",
          "context",
          "source",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "keywords": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "description": "Up to 10 topical keywords in the document language"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "pagesAnalyzed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "scannedPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "unreadPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "hiddenText": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "chars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "excerpt": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "page",
              "chars",
              "excerpt"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "contradiction",
                  "amendment",
                  "prompt_injection",
                  "illegible",
                  "other",
                  "hidden_text",
                  "scanned_pages",
                  "unread_pages",
                  "unconfirmed_values"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "description": "One sentence for the user, in the document language"
              },
              "pages": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "description": "Pages the warning refers to; empty if it concerns the whole document"
              }
            },
            "required": [
              "code",
              "message",
              "pages"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "model",
        "generatedAt",
        "pagesAnalyzed",
        "scannedPages",
        "unreadPages",
        "hiddenText",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "document",
    "summary",
    "keyPoints",
    "entities",
    "amounts",
    "dates",
    "keywords",
    "analysis"
  ],
  "additionalProperties": false
}
