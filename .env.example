# Frontend build configuration (public values only – everything prefixed VITE_ ends up in the browser bundle).
# URL of the deployed Cloudflare Worker. Locally defaults to http://localhost:8787.
VITE_API_URL=https://pdf-insight-api.<your-subdomain>.workers.dev

# The model API key is NOT configured here. It lives only in the Worker:
#   cd worker && npx wrangler secret put OPENROUTER_API_KEY     (production)
#   cp worker/.dev.vars.example worker/.dev.vars                 (local, git-ignored)
